  "spacing": {
    "_note": "8px major grid with a 4px minor fallback, per the kit's Spacing board.",
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 16,
    "4": 32,
    "5": 64,
    "6": 128,
    "7": 256,
    "8": 512
  },

  "radius": {
    "_note": "Airtable is a small-radius system. Buttons, inputs, selects and tokens are 3px; cards, dialogs and popovers 6px; the app frame 8px. Nothing is a pill except switches and avatars.",
    "button": 3,
    "input": 3,
    "select": 3,
    "token": 3,
    "badge": 3,
    "swatch": 4,
    "card": 6,
    "dialog": 6,
    "popover": 6,
    "dropdown": 6,
    "container": 6,
    "app-frame": 8,
    "switch": 999,
    "avatar": 999
  },

  "borderWidth": {
    "divider": 1,
    "container": 1,
    "input": 1,
    "control": 1,
    "focus-ring": 2,
    "tabs-underline": 2,
    "app-frame": 2
  },

  "shadow": {
    "_note": "Airtable leans on flat fills and hairlines; shadow appears only on things that float (dropdowns, dialogs, popovers, drag states).",
    "raised": { "x": 0, "y": 1, "blur": 3, "spread": 0 },
    "dropdown": { "x": 0, "y": 4, "blur": 12, "spread": 0 },
    "dialog": { "x": 0, "y": 8, "blur": 32, "spread": 0 }
  },

  "sizes": {
    "icon/small": 12,
    "icon/normal": 16,
    "icon/medium": 20,
    "icon/large": 24,
    "control/small": 24,
    "control/default": 32,
    "control/large": 40
  },

  "typography": {
    "_note": "Verbatim from the kit's type variables. The kit specifies SF Pro Text for UI/body and SF Pro Display for headings at 21px and above; both are Apple-licensed, so the theme ships Inter — see README for the substitution.",
